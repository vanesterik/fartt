# Copy to .env to change the server's settings. The environment wins over
# .env, and a relative path is relative to the repository.

# Where the server keeps its data. Defaults to assets/ in the repository.
# It holds stocks/, a cache of market data that's safe to delete, and
# journal/, the record of every call the agent made, which can't be
# rebuilt: never delete it.
# FARTT_ASSETS_DIR=assets
